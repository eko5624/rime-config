      "ref": "rime.comma",
      "swipe": { "up": { "ref": "rime.exclam" } },
      "variants": [
        {
          "when": { "rime": { "composing": true } },
          "label": "2",
          "tap": { "ref": "qwerty.comma.composing" }
        }
      ]
    },
