      "ref": "rime.space",
      "statusLabel": "schema_name",
      "keyType": "LETTER",
      "textSize": 16,
      "hintTextSize": 0,
      "tap": { "ref": "rime.space", "popup": false },
      "swipe": { "up": { "ref": "rime.Up", "label": "", "popup": false }, "down": { "ref": "rime.Down", "label": "", "popup": false }, "left": { "ref": "rime.Left", "label": "", "popup": false }, "right": { "ref": "rime.Right", "label": "", "popup": false } },
      "hold": { "label": "🎤", "start": { "type": "app", "command": "voice_start" }, "end": { "type": "app", "command": "voice_stop" } }
    },
    "qwerty.period.composing": { "ref": "rime.3" },
    "qwerty.period": {
      "ref": "rime.period",
      "swipe": { "up": { "ref": "rime.Question" } },
