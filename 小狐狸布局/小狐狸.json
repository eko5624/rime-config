            [
              { "ref": "qwerty.q", "override": { "label": "Q", "swipe": { "up": { "ref": "rime.grave" } } } },
              { "ref": "qwerty.w", "override": { "label": "W E", "swipe": { "up": { "ref": "rime.ApostropheShift" } } } },
              { "ref": "qwerty.r", "override": { "label": "R T", "swipe": { "up": { "ref": "rime.KP_Add" } } } },
              { "ref": "qwerty.y", "override": { "label": "Y", "swipe": { "up": { "ref": "rime.minus" } } } },
              { "ref": "qwerty.u", "override": { "label": "U", "swipe": { "up": { "ref": "rime.colon" } } } },
              { "ref": "qwerty.i", "override": { "label": "I O", "swipe": { "up": { "ref": "rime.Question" } } } },
              { "ref": "qwerty.p", "override": { "label": "P", "swipe": { "up": { "ref": "rime.backslash" } } } }
            ],
            {
              "width": 0.85, "keys": [
                { "ref": "qwerty.a", "override": { "label": "A", "swipe": { "up": { "ref": "rime.at" } } } },
                { "ref": "qwerty.s", "override": { "label": "S D", "swipe": { "up": { "ref": "rime.asterisk" } } } },
                { "ref": "qwerty.f", "override": { "label": "F G", "swipe": { "up": { "ref": "rime.KP_Equal" } } } },
                { "ref": "qwerty.h", "override": { "label": "H", "swipe": { "up": { "ref": "rime.percent" } } } },
                { "ref": "qwerty.j", "override": { "label": "J K", "swipe": { "up": { "ref": "rime.parenleft" } } } },
                { "ref": "qwerty.l", "override": { "label": "L", "swipe": { "up": { "ref": "rime.parenright" } } } }
              ]
            },
            [
              { "ref": "qwerty.shift", "override": { "swipe": { "up": { "type": "key", "key": "TAB", "meta": ["SHIFT"], "label": " " }, "down": { "ref": "rime.Page_Down", "label": " " } } } },
              { "ref": "qwerty.z", "weight": 1.4, "override": { "label": "Z", "swipe": { "up": { "label": "符号" }, "down": { "label": "" } }, "longPress": { "action": { "type": "switch_layout", "layout": "symbols" } } } },
              { "ref": "qwerty.x", "weight": 1.4, "override": { "label": "X C", "swipe": { "up": { "label": "全选" }, "down": { "label": "" } }, "longPress": { "ref": "foxy.SelectAll" } } },
              { "ref": "qwerty.v", "weight": 1.4, "override": { "label": "V", "swipe": { "up": { "label": "复制" }, "down": { "label": "" } }, "longPress": { "ref": "foxy.Copy" } } },
              { "ref": "qwerty.b", "weight": 1.4, "override": { "label": "B N", "swipe": { "up": { "label": "粘贴" }, "down": { "label": "" } }, "longPress": { "ref": "foxy.Paste" } } },
              { "ref": "qwerty.m", "weight": 1.4, "override": { "label": "M", "swipe": { "up": { "label": "剪切" }, "down": { "label": "" } }, "longPress": { "ref": "foxy.Cut" } } },
              { "ref": "qwerty.backspace", "weight": 1.5 }
            ],
            [
              { "ref": "qwerty.layout" },
              { "ref": "rime.Shift_L", "weight": 1.1, "override": { "label": "🌐", "variants": [ { "when": { "rime": { "composing": true } }, "tap": {"ref": "qwerty.lang.composing"}, "label": "⎋" } ] } },
              { "ref": "qwerty.comma", "weight": 0.9 },
              { "ref": "qwerty.space", "weight": 3.0 },
              { "ref": "qwerty.period", "weight": 0.9 },
              { "ref": "qwerty.slash", "weight": 1.1 },
              { "ref": "qwerty.enter" }
            ]
          ]
        }
      ]
    },
    "editor": {
      "sections": [
        {
          "type": "rows",
          "rows": [
            [
              { "ref": "editor.escape" },
              { "ref": "editor.home" },
              { "ref": "editor.up" },
              { "ref": "editor.end" },
              { "ref": "editor.delete" }
            ],
            [
              { "ref": "editor.selectAll" },
              { "ref": "editor.selectLeft" },
              { "ref": "editor.selectDown" },
              { "ref": "editor.selectUp" },
              { "ref": "editor.selectRight" }
            ],
            [
              { "ref": "editor.pageUp" },
              { "ref": "editor.left" },
              { "ref": "editor.down" },
              { "ref": "editor.right" },
              { "ref": "editor.pageDown" }
            ],
            [
              { "ref": "editor.default" },
              { "ref": "editor.insert" },
              { "ref": "editor.undo" },
              { "ref": "editor.redo" },
              { "ref": "editor.cut" },
              { "ref": "editor.copy" },
              { "ref": "editor.paste" },
              { "ref": "editor.backspace" }
            ]
          ]
        }
      ]
    },    
    "numpad": {
      "sections": [
        {
          "type": "grid",
          "columns": 5,
          "rows": 4,
          "keys": [
            { "column": 0, "row": 0, "ref": "rime.KP_Add", "keyType": "FUNCTION" },
            { "column": 1, "row": 0, "ref": "rime.1" },
            { "column": 2, "row": 0, "ref": "rime.2" },
            { "column": 3, "row": 0, "ref": "rime.3" },
            { "column": 4, "row": 0, "ref": "rime.KP_Divide", "keyType": "FUNCTION" },
            { "column": 0, "row": 1, "ref": "rime.KP_Subtract", "keyType": "FUNCTION" },
            { "column": 1, "row": 1, "ref": "rime.4" },
            { "column": 2, "row": 1, "ref": "rime.5" },
            { "column": 3, "row": 1, "ref": "rime.6" },
            { "column": 4, "row": 1, "ref": "rime.equal" },
            { "column": 0, "row": 2, "ref": "rime.KP_Multiply", "keyType": "FUNCTION" },
            { "column": 1, "row": 2, "ref": "rime.7" },
            { "column": 2, "row": 2, "ref": "rime.8" },
            { "column": 3, "row": 2, "ref": "rime.9" },
            { "column": 4, "row": 2, "ref": "rime.BackSpace", "override": { "swipe": null, "keyType": "FUNCTION", "longPress": { "repeat": true, "action": { "type": "key", "key": "BACKSPACE" } } } },
            { "column": 0, "row": 3, "ref": "foxy.LayoutDefault" },
            { "column": 1, "row": 3, "ref": "rime.space", "label": "␣", "keyType": "FUNCTION" },
            { "column": 2, "row": 3, "ref": "rime.0" },
            { "column": 3, "row": 3, "ref": "rime.KP_Decimal", "keyType": "FUNCTION" },
            { "column": 4, "row": 3, "ref": "foxy.KP_Enter" }
          ]
        }
      ]
    }
  }
}
