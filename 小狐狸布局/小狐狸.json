  "actions": {
    "select_all": {
      "type": "key",
      "key": "A",
      "meta": ["CTRL"]
    },
    "delete": {
      "type": "key",
      "key": "BACKSPACE"
    },
    "home": {
      "type": "key",
      "key": "HOME"
    },
    "select_end": {
      "type": "key",
      "key": "END",
      "meta": [ "SHIFT" ] }
  },
  "macros": {
    "clear_all": [
      { "action": "select_all" },
      { "action": "delete" }
    ],
    "select_current_line": [
      { "action": "home" },
      { "action": "select_end" }
    ],
    "full_26.to_t9": [
      { "type": "switch_layout", "layout": "wanxiang_t9" },
      { "type": "modifier", "modifier": "SHIFT", "state": "OFF" }
    ],
    "wanxiang_t9.to_full_upper": [
      { "type": "switch_layout", "layout": "full_26" },
      { "type": "modifier", "modifier": "SHIFT", "state": "TOGGLE_LOCKED" }
    ]
  },


  "layouts": {
    "default": {
      "sections": [
        {
          "type": "rows",
          "rows": [
            [
              { "ref": "rime.q", "override": { "label": "Q", "swipe": { "up": { "ref": "rime.1", "label": " 1 " }, "down": { "ref": "rime.grave", "label": " ` " } } } },
              { "ref": "rime.w", "override": { "label": "W", "swipe": { "up": { "ref": "rime.2", "label": " 2 " }, "down": { "ref": "rime.asciitilde", "label": " ~ " } } } },
              { "ref": "rime.e", "override": { "label": "E", "swipe": { "up": { "ref": "rime.3", "label": " 3 " }, "down": { "ref": "rime.plus", "label": " + " } } } },
              { "ref": "rime.r", "override": { "label": "R", "swipe": { "up": { "ref": "rime.4", "label": " 4 " }, "down": { "ref": "rime.minus", "label": " - " } } } },
              { "ref": "rime.t", "override": { "label": "T", "swipe": { "up": { "ref": "rime.5", "label": " 5 " }, "down": { "ref": "rime.equal", "label": " = " } } } },
              { "ref": "rime.y", "override": { "label": "Y", "swipe": { "up": { "ref": "rime.6", "label": " 6 " }, "down": { "ref": "rime.underscore", "label": " _ " } } } },
              { "ref": "rime.u", "override": { "label": "U", "swipe": { "up": { "ref": "rime.7", "label": " 7 " }, "down": { "ref": "rime.braceleft", "label": " { " } } } },
              { "ref": "rime.i", "override": { "label": "I", "swipe": { "up": { "ref": "rime.8", "label": " 8 " }, "down": { "ref": "rime.braceright", "label": " } " } } } },
              { "ref": "rime.o", "override": { "label": "O", "swipe": { "up": { "ref": "rime.9", "label": " 9 " }, "down": { "ref": "rime.bracketleft", "label": " [ " } } } },
              { "ref": "rime.p", "override": { "label": "P", "swipe": { "up": { "ref": "rime.0", "label": " 0 " }, "down": { "ref": "rime.bracketright", "label": " ] " } } } } 
            ],
            [
              { "ref": "rime.a", "override": { "label": "A", "swipe": { "up": { "ref": "rime.at", "label": " @ " } } } },
              { "ref": "rime.s", "override": { "label": "S", "swipe": { "up": { "ref": "rime.numbersign", "label": " # " } } } },
              { "ref": "rime.d", "override": { "label": "D", "swipe": { "up": { "ref": "rime.dollar", "label": " $ " } } } },
              { "ref": "rime.f", "override": { "label": "F", "swipe": { "up": { "ref": "rime.percent", "label": " % " } } } },
              { "ref": "rime.g", "override": { "label": "G", "swipe": { "up": { "ref": "rime.asciicircum", "label": " ^ " } } } },
              { "ref": "rime.h", "override": { "label": "H", "swipe": { "up": { "ref": "rime.ampersand", "label": " & " } } } },
              { "ref": "rime.j", "override": { "label": "J", "swipe": { "up": { "ref": "rime.asterisk", "label": " * " }, "down": { "macro": "select_current_line", "label": "选行" } } } },
              { "ref": "rime.k", "override": { "label": "K", "swipe": { "up": { "ref": "rime.parenleft", "label": " ( " }, "down": { "ref": "rime.Home", "label": "行首" } } } },
              { "ref": "rime.l", "override": { "label": "L", "swipe": { "up": { "ref": "rime.parenright", "label": " ) " }, "down": { "ref": "rime.End", "label": "行尾" } } } },
              { "ref": "qwerty.semicolon" }
            ],
           [
             { "ref": "qwerty.shift" },
             { "ref": "rime.z", "override": { "label": "Z", "swipe": { "up": { "label": "全选" } }, "longPress": { "ref": "foxy.SelectAll", "popup": false } } },
             { "ref": "rime.x", "override": { "label": "X", "swipe": { "up": { "label": "剪切" } }, "longPress": { "ref": "foxy.Cut", "popup": false } } },
             { "ref": "rime.c", "override": { "label": "C", "swipe": { "up": { "label": "复制" } }, "longPress": { "ref": "foxy.Copy", "popup": false } } },
             { "ref": "rime.v", "override": { "label": "V", "swipe": { "up": { "label": "粘贴" } }, "longPress": { "ref": "foxy.Paste", "popup": false } } },
             { "ref": "rime.b", "override": { "label": "B", "swipe": { "up": { "label": "符号" } }, "longPress": { "action": { "type": "switch_layout", "layout": "symbols" } } } },
             { "ref": "qwerty.n", "override": { "label": "N" } },
             { "ref": "qwerty.m", "override": { "label": "M", "swipe": { "up": { "ref": "rime.quotedbl", "label": "\"" } } } },
             { "ref": "qwerty.backspace", "weight": 1.5 }
            ],
